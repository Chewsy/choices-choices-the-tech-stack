---
const { value, label, index } = Astro.props;
---
<label class={`bingokaart-radiobutton value-${value}`}>
    <input
        type="radio"
        name={`state-${index}`}
        {value}
        onclick="event.stopPropagation()"
    />
    {label}
</label>

<style>
    .bingokaart-radiobutton {
        display: flex;
        flex-direction: column;
        gap: 5px;
        align-items: center;
        text-align: center;
        border: none;
    }

    input {
        appearance: none;

        border-radius: 50%;
        width: 16px;
        height: 16px;

        border: 2px solid var(--color-primary-700);

        position: relative;
        top: 4px;
        cursor: pointer;
    }

    input:checked {
        background-color: var(--color-primary-700);
    }

    /* `Niet gedaan` (value 0) — donkergrijs */
    .value-0 {
        input {
            border-color: var(--color-neutral-dark);
        }

        input:checked {
            background-color: var(--color-neutral-dark);
        }
    }

    /* `Mee bezig` (value 1) — donkerblauw */
    .value-1 {
        input {
            border-color: var(--color-primary-700);
        }

        input:checked {
            background-color: var(--color-primary-700);
        }
    }

    /* `Gedaan` (value 2) — donkergroen */
    .value-2 {
        input {
            border-color: var(--color-green-800);
        }

        input:checked {
            background-color: var(--color-green-800);
        }
    }
</style>