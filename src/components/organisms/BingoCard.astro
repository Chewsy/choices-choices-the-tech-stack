---
import Activity from "../atoms/Activity.astro";
import RadioButtonGroup from "../molecules/RadioButtonGroup.astro";
const { card } = Astro.props;
---

<article class="bingokaart state-1" data-card={card.id}>
    <Activity card={card} />
    <RadioButtonGroup card={card} />
</article>

<style>
    .bingokaart {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 20px;
        border: 1px solid var(--border-color);
        width: 250px;
        height: 200px;
        border-radius: 5px;
    }

    /* Kaart-achtergrond per state (kaart zelf) */
    .state-1 {
        background-color: var(--color-neutral-lighter);
    }
    .state-2 {
        background-color: hsl(204, 59%, 72%);
    }
    .state-3 {
        background-color: hsl(85, 57%, 64%);
    }

    /* Radio-kleur volgt de kaart-state.
       :global() laat de kaart de inputs in kind-componenten bereiken. */
    .state-1 :global(.bingokaart-radiobutton input) {
        border-color: var(--color-neutral-dark);
    }
    .state-1 :global(.bingokaart-radiobutton input:checked) {
        background-color: var(--color-neutral-dark);
        border-color: var(--color-neutral-dark);
    }

    .state-2 :global(.bingokaart-radiobutton input) {
        border-color: var(--color-primary-700);
    }
    .state-2 :global(.bingokaart-radiobutton input:checked) {
        background-color: var(--color-primary-700);
        border-color: var(--color-primary-700);
    }

    .state-3 :global(.bingokaart-radiobutton input) {
        border-color: var(--color-green-800);
    }
    .state-3 :global(.bingokaart-radiobutton input:checked) {
        background-color: var(--color-green-800);
        border-color: var(--color-green-800);
    }
</style>