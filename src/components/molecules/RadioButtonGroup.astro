---
import BingoRadioButton from "../atoms/BingoRadioButton.astro";
const { card } = Astro.props;
---

<fieldset class="radiobuttons">
    <BingoRadioButton card={card} value={1} label="Niet gedaan" />
    <BingoRadioButton card={card} value={2} label="Mee bezig" />
    <BingoRadioButton card={card} value={3} label="Gedaan" />
</fieldset>

<style>
    .radiobuttons {
        display: flex;
        flex-direction: row;
        gap: 15px;
        align-items: center;
        border: none;
        margin: 0;
        padding: 0;
    }
</style>