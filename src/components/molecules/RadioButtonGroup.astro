---
import BingoRadioButton from "../atoms/BingoRadioButton.astro";
const { index } = Astro.props;
---

<fieldset id={`radiobuttons-${index}`} class="RadioButtonGroup">
	<BingoRadioButton value={0} label="Niet gedaan" {index} />
	<BingoRadioButton value={1} label="Mee bezig" {index} />
	<BingoRadioButton value={2} label="Gedaan" {index} />
</fieldset>

<style>
	fieldset {
		display: flex;
		flex-direction: row;
		gap: 15px;
		align-items: center;
		border: none;
	}

	.RadioButtonGroup {
		display: flex;
	}
</style>